ORDER_AGENT_MODEL_PROVIDER=none
INVENTORY_AGENT_A2A_URL=http://inventory-agent:7002
ORDER_QUEUE_NAME=agent-orders
ORDER_QUEUE_HOSTNAME=rabbitmq
ORDER_QUEUE_PORT=5672
ORDER_QUEUE_USERNAME=username
ORDER_QUEUE_PASSWORD=password
ORDER_QUEUE_URI=amqp://rabbitmq:5672
# Set true to use Microsoft Entra workload identity for Service Bus and Foundry.
USE_WORKLOAD_IDENTITY_AUTH=false
# AZURE_SERVICEBUS_FULLYQUALIFIEDNAMESPACE=<namespace>.servicebus.windows.net

# Local model path (OpenAI-compatible endpoint such as Ollama or vLLM)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_CHAT_MODEL=gpt-oss:20b
OPENAI_API_KEY=none

# Foundry model path (OpenAI-compatible endpoint exposed by your project)
FOUNDRY_OPENAI_BASE_URL=
FOUNDRY_OPENAI_CHAT_MODEL=
FOUNDRY_OPENAI_API_KEY=

# Foundry workload identity path
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_MODEL=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

ENABLE_INSTRUMENTATION=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=order-agent
